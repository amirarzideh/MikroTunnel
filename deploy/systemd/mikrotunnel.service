[Unit]
Description=MikroTunnel network management agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/mikrotunnel serve --config /etc/mikrotunnel/config.yaml
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/etc/mikrotunnel /var/lib/mikrotunnel

[Install]
WantedBy=multi-user.target
